{
    "name":"orm4cf",
    "version":"5.3.0",
    "location":"https://github.com/modules4cf/orm4cf/releases/download/v@build.version@/orm4cf-@build.version@.zip",
    "author":"modules4cf contributors",
    "homepage":"https://github.com/modules4cf/orm4cf",
    "documentation":"https://coldbox-orm.ortusbooks.com/",
    "repository":{
        "type":"git",
        "url":"https://github.com/modules4cf/orm4cf"
    },
    "bugs":"https://github.com/modules4cf/orm4cf/issues",
    "shortDescription":"Enhances the Hibernate ORM on CFML Engines with tons of utilities.",
    "slug":"orm4cf",
    "type":"modules",
    "keywords":"hibernate, orm extensions, orm",
    "license":[
        {
            "type":"Apache-2.0",
            "url":"https://www.apache.org/licenses/LICENSE-2.0"
        }
    ],
    "contributors":[
        "Brad Wood <bdw429s@gmail.com>",
        "Curt Gratz <gratz@computerknowhow.com>",
        "Joel Watson <existdissolve@gmail.com>"
    ],
    "dependencies":{
        "cbvalidation":"^4.0.0",
        "mementifier":"^3.0.0",
        "cbstreams":"^2.0.0",
        "cbpaginator":"^2.0.0"
    },
    "devDependencies":{
        "commandbox-cfformat":"*",
        "commandbox-docbox":"*"
    },
    "ignore":[
        "**/.*",
        "test-harness",
        "/server*.json"
    ],
    "testbox":{
        "runner":"http://localhost:60299/tests/runner.cfm"
    },
    "scripts":{
        "build:module":"task run taskfile=Build.cfc :projectName=`package show slug` :version=`package show version`",
        "build:docs":"task run taskfile=Build.cfc target=docs :projectName=`package show slug` :version=`package show version`",
        "format":"cfformat run aop,dsl,interceptors,models,test-harness/tests/,ModuleConfig.cfc --overwrite",
        "format:watch":"cfformat watch aop,dsl,interceptors,models,test-harness/tests/,ModuleConfig.cfc ./.cfformat.json",
        "format:check":"cfformat check aop,dsl,interceptors,models,test-harness/tests/,ModuleConfig.cfc ./.cfformat.json",
        "install:dependencies":"install --force && cd test-harness && install --force",
        "startdbs":"!docker-compose -f docker-compose.yml up",
        "start:lucee":"server start serverConfigFile=server-lucee@7.json",
        "start:adobe":"server start serverConfigFile=server-adobe@2025.json",
        "stop:lucee":"server stop serverConfigFile=server-lucee@7.json",
        "stop:adobe":"server stop serverConfigFile=server-adobe@2025.json",
        "logs:lucee":"server log serverConfigFile=server-lucee@7.json --follow",
        "logs:adobe":"server log serverConfigFile=server-adobe@2025.json --follow"
    },
    "installPaths":{
        "cbvalidation":"modules/cbvalidation/",
        "mementifier":"modules/mementifier/",
        "cbstreams":"modules/cbstreams/",
        "cbpaginator":"modules/cbpaginator/"
    }
}